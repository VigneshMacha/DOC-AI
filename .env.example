# =========================================================
# LLM & EMBEDDING CONFIGURATION (Mistral AI)
# =========================================================
MISTRAL_API_KEY=your_mistral_api_key_here
EMBEDDING_MODEL=mistral-embed
LLM_MODEL=mistral-small-2603

# =========================================================
# SUPABASE DATABASE & AUTHENTICATION
# =========================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: Supabase Table Overrides (defaults shown)
DOCUMENTS_TABLE=documents
CONVERSATIONS_TABLE=conversations
MESSAGES_TABLE=messages

# =========================================================
# RAG PIPELINE & RETRIEVAL SETTINGS
# =========================================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
DEFAULT_K=4
DEFAULT_FETCH_K=12
DEFAULT_LAMBDA=0.5

# =========================================================
# UPLOAD LIMITS & VALIDATION
# =========================================================
MAX_UPLOAD_MB=20
MAX_FILES_PER_UPLOAD=10
MAX_QUESTION_LENGTH=4000

# =========================================================
# OCR SETTINGS (Optional - for scanned PDFs)
# Example Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Example Linux/macOS: /usr/bin/tesseract
# =========================================================
TESSERACT_CMD=

# =========================================================
# APPLICATION & SECURITY CONFIGURATION
# =========================================================
# Set COOKIE_SECURE to true in production (HTTPS), false for local localhost testing
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
LOG_LEVEL=INFO
AUTH_RETRIES=2
AUTH_RETRY_DELAY=0.35
